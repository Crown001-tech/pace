# PACE Environment Configuration (Example)
# Copy to .env for local overrides (never commit .env)

# Environment
PACE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://pace:pace@localhost:5432/pace

# S3 / Object Storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pace
S3_ACCESS_KEY=pace
S3_SECRET_KEY=pace-secret

# API Configuration
API_PORT=8080
API_HOST=127.0.0.1
SESSION_SECRET=local-development-session-secret-change-in-production-min-32-chars

# Transcription (Groq Whisper API)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
