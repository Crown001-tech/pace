{
  "manifest_version": 3,
  "name": "PACE — Google Flow Connector",
  "version": "0.1.0",
  "description": "Run Image & Video prompt queues in Google Flow and send generated media straight to your PACE project.",
  "permissions": [
    "storage",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://storage.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PACE × Google Flow"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*",
        "https://*.labs.google/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
