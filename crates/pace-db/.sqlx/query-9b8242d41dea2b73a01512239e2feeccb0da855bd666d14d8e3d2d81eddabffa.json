  "query": "\n        UPDATE projects\n        SET name = $3,\n            aspect_ratio = $4,\n            settings = $5,\n            status = $6,\n            version = version + 1\n        WHERE id = $1 AND owner_id = $2 AND version = $7\n        RETURNING id, owner_id, name, aspect_ratio, fps, language, effect_seed,\n                  settings, version, status, created_at, updated_at, deleted_at\n        ",
